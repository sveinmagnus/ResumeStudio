node_modules/
dist/
coverage/

# Playwright e2e artifacts
test-results/
playwright-report/

# Portable desktop build output (assembled by scripts/build-desktop.mjs)
release/
release-dist/

# Runtime data — database lives here, never commit it
data/

# Real exports/DBs used to rehearse migrations. Every file here is one
# identified person's CV, so it stays out of the repo — commit the anonymised
# fixtures derived from it, never the source.
corpus/

# Environment — contains the API secret token
.env
.env.local

# Personal Claude Code permission allowlist — stays out of the repo.
# (settings.local.json is ignored via the global gitignore; this covers the
# shared file too, since it only ever holds per-user prefs in this project.)
.claude/settings.json
reports/
.stryker-tmp/

# Generated per-file by scripts/mutation-run.mjs; deleted after each run.
# NOT vitest.mutation.config.ts, which is checked in — these patterns need a
# module name in the middle, and widening them to `vitest.mutation.*` would
# quietly untrack it.
vitest.mutation.*.config.ts
stryker.mutation.*.json
