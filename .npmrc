# `npm ci` re-resolves peer ranges strictly and fails on eslint-plugin-jsx-a11y,
# whose declared peer range stops at ESLint 9 while this repo is on 10. The
# incompatibility is on paper only — the plugin's rules were probe-tested
# against real violations on ESLint 10 and fire correctly — but without this
# line a clean `npm ci` fails, which means CI fails and a fresh clone can't
# install. Remove it when jsx-a11y widens its peer range.
legacy-peer-deps=true
