{
  "name": "resume-manager",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,yellow \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch scripts/dev-server.mjs",
    "dev:translate": "docker compose up -d libretranslate",
    "translate:down": "docker compose stop libretranslate",
    "build": "vite build",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:text": "node scripts/check-control-chars.mjs",
    "check:arch": "node scripts/check-arch-map.mjs",
    "start": "NODE_ENV=production tsx server/index.ts",
    "desktop": "npm run build && tsx server/desktop/launcher.ts",
    "build:desktop": "npm run build && node scripts/build-desktop.mjs",
    "gen:icons": "node scripts/gen-section-icons.mjs",
    "gen:taxonomy": "node scripts/build-skill-taxonomy.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "node scripts/mutation-run.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:mutation:report": "node scripts/mutation-run.mjs --report"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "docx": "^9.7.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.28.0",
    "pdfmake": "^0.3.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "systray2": "^2.1.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/express": "^5.0.6",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.26",
    "concurrently": "^10.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.9.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "minimatch@3": {
      "brace-expansion": "^1.1.18"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "typed-rest-client": {
      "qs": "^6.15.2"
    }
  }
}
